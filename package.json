{
  "name": "memory-runtime-intelligence",
  "version": "1.0.1",
  "bin": {
    "memory-runtime-intelligence": "./dist/cli.js"
  },
  "description": "Runtime resource retention detection for web applications.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "example": "tsx src/example/index.ts",
    "prepare": "husky"
  },
  "keywords": [
    "memory",
    "runtime",
    "browser",
    "debugging",
    "leak-detection",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "next": "^16.3.5",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "webpack": "^5.110.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "jsdom": "^29.1.1",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "vite": "^8.2.2"
  }
}
